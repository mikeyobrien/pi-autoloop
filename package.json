{
  "name": "pi-autoloop",
  "version": "0.1.0",
  "description": "Pi extension for running autoloop autonomous LLM loops",
  "type": "module",
  "license": "MIT",
  "author": "mikeyobrien",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeyobrien/pi-autoloop"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "autoloop",
    "llm",
    "autonomous"
  ],
  "files": [
    "*.ts",
    "!*.test.ts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@mobrienv/autoloop": "^0.12.0",
    "@mobrienv/autoloop-core": "^0.12.0",
    "@mobrienv/autoloop-harness": "^0.12.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "*",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
